# NEEL PULP TRAY - public site configuration
# Copy this file to .env.local and fill in the real values before deploying.

# WhatsApp number that receives enquiries, digits only, with country code, no '+'.
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Phone number displayed on the contact section (human readable).
NEXT_PUBLIC_PHONE="+91 90000 00000"

# Email displayed on the contact section.
NEXT_PUBLIC_EMAIL=sales@example.com

# Factory address shown in contact + footer.
NEXT_PUBLIC_FACTORY_ADDRESS="Factory address line, City, State, PIN, India"

# Optional: form backend endpoint (e.g. Formspree, Getform, or your own API route).
# When set, the enquiry form also POSTs the enquiry as JSON to this URL.
# When empty, the form hands the enquiry to WhatsApp only.
NEXT_PUBLIC_FORM_ENDPOINT=